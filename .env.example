# Public canonical origin. Must match the production browser origin.
NEXT_PUBLIC_SITE_URL=https://nationalrentals.ca

# Server-only. Resend must verify this sender's domain before sending.
RESEND_API_KEY=
QUOTE_FROM_EMAIL=

# Shared REST Redis service (Upstash-compatible) for production replicas/serverless.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
# Only set when your reverse proxy OVERWRITES this header with a trusted client IP.
# Examples depend on the hosting platform; do not trust arbitrary forwarded headers.
TRUSTED_CLIENT_IP_HEADER=

# Optional alternative for one long-lived Node process only; NOT serverless/multi-replica.
# RATE_LIMIT_MODE=single-instance

# Enable call links only after the owner verifies routing/ownership.
NEXT_PUBLIC_PHONE_VERIFIED=false
NEXT_PUBLIC_PHONE_NUMBER=+18336969996
NEXT_PUBLIC_PHONE_DISPLAY=(833) 696-9996
