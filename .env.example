# Public canonical origin. Must match the production browser origin.
NEXT_PUBLIC_SITE_URL=https://nationalrentals.ca

# Server-only. Resend must verify this sender's domain before sending.
RESEND_API_KEY=
QUOTE_FROM_EMAIL=

# Shared REST Redis service (Upstash-compatible) for production replicas/serverless.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
# Only set when your reverse proxy OVERWRITES this header with a trusted client IP.
# Examples depend on the hosting platform; do not trust arbitrary forwarded headers.
TRUSTED_CLIENT_IP_HEADER=

# Optional alternative for one long-lived Node process only; NOT serverless/multi-replica.
# RATE_LIMIT_MODE=single-instance

# Enable call links only after the owner verifies routing/ownership.
NEXT_PUBLIC_PHONE_VERIFIED=false
NEXT_PUBLIC_PHONE_NUMBER=+18336969996
NEXT_PUBLIC_PHONE_DISPLAY=(833) 696-9996

# Phase 1D: mandatory durable private storage. Node >=22.16 with node:sqlite.
# Single persistent host/volume only; ephemeral/serverless filesystems are unsupported.
# Use an absolute path OUTSIDE the repository, web root and build artifacts.
# Example location: /var/lib/nationalrentals/leads.sqlite (directory owned by the app user).
LEAD_DB_PATH=
# Generate a unique 32-byte base64 key with: openssl rand -base64 32
# Keep separately from DB/backups. Losing it makes stored inquiries unrecoverable.
LEAD_ENCRYPTION_KEY=

# Optional first-party measurement relay. No events are sent before visitor opt-in.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# HTTPS endpoint accepting {event,url}; receives no browser IP/cookies/form data.
ANALYTICS_ENDPOINT=
ANALYTICS_TOKEN=
